# Server
PORT=3000
NODE_ENV=development

# Service metadata
SERVICE_NAME=OpenWorld VPN Backend

# API
API_PREFIX=/api/v1

# Logging
LOG_LEVEL=info

# Database (Prisma schema defined in prisma/schema.prisma; not connected
# to a real database yet — placeholder value only, no real credentials)
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/openworld_vpn

# Authentication (JWT session tokens)
# No real secret is provided here — generate a strong random value per
# environment. Never commit real secrets to source control.
JWT_SECRET=<replace-with-a-strong-random-secret>
JWT_EXPIRES_IN_SECONDS=3600

# OAuth / social login providers (Phase 3 uses mock provider responses
# only — no real provider credentials are configured or required yet)
# GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID=
# WECHAT_APP_ID=
